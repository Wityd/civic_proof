# Optional: contracts/.env. The repo-root .env is read too; either file works.

# Testnet-only key, used on BOTH Avalanche Fuji and BNB testnet.
# Never use a key that has ever held real funds.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints (defaults shown; override if one is slow)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# One Etherscan.io API key (v2) verifies on BscScan. Snowtrace accepts any value.
ETHERSCAN_API_KEY=

# Filled in by `npm run deploy:fuji` / `npm run deploy:bsc`, then copied to the API's .env.
# Each chain has its own addresses; the API uses the chain selected by WALLET_MODE.
DEMOZAR_ADDRESS=
FACTORY_ADDRESS=

# Used by `npm run setup:demo:*`: uuids from supabase/seed.sql (same on both chains)
PROJECT_UUID=
PROJECT_ALLOCATION_CENTS=200000000
MILESTONE_M1_UUID=

# Used by `npm run live:invoice1` (runs demo invoice #1 through the LIVE API).
# The anon key is browser-safe; the passwords are private: keep them only in .env.
SUPABASE_URL=https://crshjvjrgnnypxbpjmob.supabase.co
SUPABASE_ANON_KEY=
SUPPLIER_EMAIL=
SUPPLIER_PASSWORD=
MUNICIPALITY_EMAIL=
MUNICIPALITY_PASSWORD=
